<resources>
    <style name="VaultTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#5C3A99</item>
        <item name="android:alertDialogTheme">@style/VaultDialog</item>
        <item name="android:datePickerDialogTheme">@style/VaultDateDialog</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="VaultDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#5C3A99</item>
        <item name="android:textColorPrimary">#191822</item>
        <item name="android:textColorSecondary">#646075</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/VaultDialogButton</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/VaultDialogButton</item>
    </style>
    <style name="VaultDateDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">#5C3A99</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
    </style>
    <style name="VaultDialogButton" parent="android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">#5C3A99</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
